{
    "name": "mades/summer-craft-core",
    "description": "The -=Summer Craft=- Framework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "psr/log": "^3.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-mbstring": "Preferred way to drop invalid characters from output; the application refuses to boot only if neither mbstring nor iconv is available",
        "ext-yaml": "Required only by SummerCraft\\Core\\Context\\Yaml — an application that configures itself from a .yaml file must require this itself"
    },
    "autoload": {
        "psr-4": {
            "SummerCraft\\Core\\": "src/SummerCraft/Core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SummerCraft\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
